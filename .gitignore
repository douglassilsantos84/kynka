# ==========================================
# Kynka - Git Ignore
# ==========================================

# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment variables / secrets
.env
.env.*
!.env.example

# Distribution / packaging
build/
dist/
*.egg-info/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Type checking / lint
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/

# Logs
logs/
*.log

# Local databases
*.db
*.sqlite
*.sqlite3

# Local spreadsheets / test data
*.xlsx
*.xls

# Temporary / snapshot files
*_snapshot.txt
*_clean.txt
etapa*_backend_atual.txt

# Operating system
Thumbs.db
.DS_Store