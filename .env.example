KYNKA_APP_NAME=Kynka API
KYNKA_VERSION=6.0.0
KYNKA_MODEL=llama3.2:3b
KYNKA_MEMORY_SIZE=100
KYNKA_SESSION_TTL_MINUTES=120
KYNKA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ETAPA 21B - EMAIL QUOTES
KYNKA_EMAIL_ENABLED=false
KYNKA_EMAIL_IMAP_HOST=imap.gmail.com
KYNKA_EMAIL_IMAP_PORT=993
KYNKA_EMAIL_IMAP_SSL=true
KYNKA_EMAIL_USERNAME=
KYNKA_EMAIL_PASSWORD=
KYNKA_EMAIL_MAILBOX=INBOX
KYNKA_EMAIL_MAX_MESSAGES=50
KYNKA_EMAIL_POLL_MINUTES=5

# ETAPA 22 - DOCUMENT INTELLIGENCE
KYNKA_OLLAMA_URL=http://127.0.0.1:11434
KYNKA_EMBEDDING_MODEL=nomic-embed-text
KYNKA_LOCAL_EMBEDDING_DIMENSION=384
KYNKA_DOCUMENT_CHAT_MODEL=llama3.2:3b

# ETAPAS 31-34 - PRODUCTION / DATABASE / REALTIME / MOBILE
# SQLite continua sendo o backend ativo. PostgreSQL e um alvo de migracao da Etapa 32,
# mas os repositorios legados ainda precisam ser portados antes de ativar postgres em producao.
KYNKA_DATABASE_URL=sqlite:///data/kynka.db
KYNKA_LOG_FORMAT=json
KYNKA_REALTIME_TRANSPORT=sse

# ETAPAS 35-38 - MULTIMODAL / AVATAR / SPATIAL
KYNKA_MULTIMODAL_PROTOCOL=kynka-multimodal/1.0
KYNKA_SPATIAL_PROTOCOL=kynka-spatial/1.0
KYNKA_STT_PROVIDER=adapter-required
KYNKA_TTS_PROVIDER=adapter-required
